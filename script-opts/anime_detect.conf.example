# anime_detect.lua options
# Copy to anime_detect.conf and fill in the key.
# Leave tmdb_api_key empty to fall back to the TMDB_API_KEY env var (see .env).
tmdb_api_key=
genre_ids=16
min_score=0.0
skip_protocols=http,https,rtmp,rtsp
# Genre 16 = "Animation" also matches Pixar/Disney/Arcane; Anime4K's
# line-art tuning suits Japanese anime, not western 3D CGI. Require a
# Japanese signal: TMDB original language ja OR a ja audio track in the
# file (catches co-productions TMDB tags en, like Edgerunners). Set no
# to classify all animation as anime.
japanese_only=yes
# Leading [release group] tags naming a series the filename never does, as
# Tag=Series pairs (comma separated). "[One Pace][1079] Egghead 13" gives
# TMDB nothing to find; the alias queries One Piece instead.
group_aliases=One Pace=One Piece
debug=no
