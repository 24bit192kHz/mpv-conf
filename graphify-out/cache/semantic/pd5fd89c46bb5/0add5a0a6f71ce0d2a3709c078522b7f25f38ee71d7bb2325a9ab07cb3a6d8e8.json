{"nodes": [{"id": "readme_mpvconfig", "label": "mpv config \u2014 personal mpv configuration", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_arsubs", "label": "ar_subs \u2014 Arabic subtitle system", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "End-to-end pipeline: auto-fetch Arabic subtitle then auto-align. Three sources tried in order (offline Subscene index first for zero-quota LAN-fast lookup, SubSource preferred online, SubDL last-resort). Episode matching, season-pack unpacking, and per-season search cache are shared by all three sources."}, {"id": "readme_autosubsync", "label": "autosubsync \u2014 automatic subtitle timing", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs (Auto-sync)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embedded text subtitle preferred (one windowed ffmpeg pass, dialogue-only filtered, sub-to-sub ffsubsync) because it is more reliable; bounded audio VAD is the fallback (capped window, serialized-speech cache). Offset+scale cached per episode so replays apply in ~20 ms; next episodes' refs prefetched in background; implausible alignments (cues past end-of-media = wrong release) rejected instead of loaded."}, {"id": "readme_subsceneindex", "label": "Offline Subscene index (Docker FTS5 API)", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs (source 1)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional Docker API (subtitle-api/, not in this repo) over a ~306k-subtitle FTS5 index of the Subscene Arabic dump. Checked first: zero quota and LAN-fast, avoiding online API limits."}, {"id": "readme_subsource", "label": "SubSource.net \u2014 preferred online subtitle source", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs (source 2)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred online source (SUBSOURCE_API_KEY): per-season show resolution and episode-filtered pack ranking."}, {"id": "readme_subdl", "label": "SubDL \u2014 last-resort subtitle fallback", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs (source 3)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last-resort fallback (SUBDL_API_KEY) using TMDB/TVDB metadata for title/season/episode detection."}, {"id": "readme_tmdb", "label": "TMDB \u2014 movie/series metadata service", "file_type": "concept", "source_file": "README.md", "source_location": "## API keys", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tvdb", "label": "TVDB \u2014 optional anime episode metadata", "file_type": "concept", "source_file": "README.md", "source_location": "## API keys", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_zstdcache", "label": "zstd-compressed subtitle cache (~/.cache/mpv)", "file_type": "concept", "source_file": "README.md", "source_location": "## ar_subs / ## State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subtitles stored compressed at rest (.ass.zst/.srt.zst, zstd-19 via in-process LuaJIT FFI \u2014 no subprocess) under one cache root, decompressed into an LRU hot/ dir on load in sub-milliseconds. All regenerable state under one root so deleting it gives a clean start."}, {"id": "readme_animestack", "label": "Anime stack (shaders + auto profile + SmartSkip)", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_krigbilateral", "label": "KrigBilateral chroma shader", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Shaders)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ssimsuperres", "label": "SSimSuperRes shader (ringing/sharpness)", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Shaders)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ssimdownscaler", "label": "SSimDownscaler shader", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Shaders)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_anime4k", "label": "Anime4K v4.x Mode A shader chain", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Shaders)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_animeprofile", "label": "[Anime] auto profile", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Auto profile)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Swaps in the Anime4K chain as a replace (not stack); HDR sources excluded; height-gated so 4K falls back to the SSim chain instead of upscaling pointlessly."}, {"id": "readme_animedetect", "label": "anime_detect.lua \u2014 anime classifier", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (Auto profile)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classifies via TMDB Animation genre + Japanese original language so western animation (Pixar/Arcane) stays off the Anime4K path; /Anime/ folder path also triggers. Reads TMDB_API_KEY straight from the environment."}, {"id": "readme_smartskip", "label": "SmartSkip \u2014 Opening/Ending/Preview auto-skip", "file_type": "concept", "source_file": "README.md", "source_location": "## Anime stack (SmartSkip)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From awesome-mpv (stax76): auto-skips chapters after a 3 s cancelable countdown; silence-based skip (?) covers unchaptered files."}, {"id": "readme_dynamiccrop", "label": "Dynamic crop", "file_type": "concept", "source_file": "README.md", "source_location": "## Dynamic crop", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses the native C++ sidecar in cuda-crop-cpp/ (ffprobe + ffmpeg cropdetect \u2014 no Python). Installer tries to build it automatically; requires CMake, a C++17 compiler, nlohmann_json, and ffprobe/ffmpeg at runtime."}, {"id": "readme_uosc", "label": "uosc UI", "file_type": "concept", "source_file": "README.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_hdrprofiles", "label": "HDR profiles", "file_type": "concept", "source_file": "README.md", "source_location": "intro", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_mpvconfig", "target": "readme_arsubs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "intro", "weight": 1.0}, {"source": "readme_mpvconfig", "target": "readme_animestack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "intro", "weight": 1.0}, {"source": "readme_mpvconfig", "target": "readme_dynamiccrop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "intro", "weight": 1.0}, {"source": "readme_mpvconfig", "target": "readme_uosc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "REA